# Copy to .env for local runs. Never commit the real file.

# Option 1 (free): a Google Gemini key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# Option 2 (paid): an Anthropic key from https://console.anthropic.com
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-4-6

# If both keys are set, Gemini is used unless you set AI_PROVIDER=claude.
# AI_PROVIDER=gemini
